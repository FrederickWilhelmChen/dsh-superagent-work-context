{
  "name": "dsh-superagent-work-context",
  "version": "0.1.0",
  "description": "Evidence-backed Feishu work context and private reminders for DSH SuperAgent",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "superagent", "feishu"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrederickWilhelmChen/dsh-superagent-work-context.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "proper-lockfile": "4.1.2"
  },
  "scripts": {
    "test": "node --test"
  }
}

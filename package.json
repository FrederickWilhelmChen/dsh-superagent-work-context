{
  "name": "dsh-feishu-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 飞书插件：右侧边栏读取飞书任务 / 总结机器人所在群聊，并把任务一键加入输入框",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "scripts"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "check": "node scripts/check.mjs",
    "bootstrap": "node scripts/bootstrap-deps.mjs",
    "apply-profile": "node scripts/apply-profile.mjs",
    "panel-check": "node scripts/panel-check.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": []
    }
  },
  "engines": {
    "node": ">=20"
  }
}
